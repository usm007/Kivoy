<Window x:Class="Kivoy.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy — New Download"
        Width="580" Height="540"
        MinWidth="520" MinHeight="460"
        MaxWidth="700" MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sign-in required notice -->
        <Border Grid.Row="0"
                Margin="14,12,14,0"
                Background="{DynamicResource NotificationBackground}"
                BorderBrush="{DynamicResource Accent}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Visibility="{Binding LoginRequired, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="{DynamicResource Accent}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="This video needs a signed-in YouTube account."
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="14,5"
                            Command="{Binding SignInYouTubeCommand}"
                            ToolTip="Sign in with your Google account">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Sign in to YouTube" FontSize="12.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Margin="6,0,0,0"
                            Command="{Binding DismissLoginNoticeCommand}"
                            ToolTip="Dismiss">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="14,14,14,6">

                <!-- URL card -->
                <Border Padding="12"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search icon + URL input inside a pill -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextTertiary}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <TextBox x:Name="UrlBox"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         BorderBrush="Transparent"
                                         BorderThickness="0"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="13" />
                            </Grid>
                        </Border>

                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Command="{Binding PasteUrlCommand}"
                                ToolTip="Paste from clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Paste" FontSize="13" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                Padding="18,8"
                                Command="{Binding AnalyzeCommand}"
                                ToolTip="Analyze link (Enter)">
                            <Grid>
                                <TextBlock Text="Analyze"
                                           FontSize="13"
                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Style="{StaticResource Spinner}" Width="13" Height="13" />
                                    <TextBlock Text="Analyzing…" Margin="7,0,0,0" FontSize="13" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- Media info card -->
                <Border Padding="12"
                        Margin="0,10,0,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Width="140" Height="79"
                                    CornerRadius="4"
                                    Background="{DynamicResource ThumbnailBg}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding SourceThumbnail}" Stretch="UniformToFill" />
                                    <Border Background="#CC000000"
                                            CornerRadius="0,0,0,4"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Visibility="{Binding IsPlaylist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SourceDuration}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                    <Border Background="#CC6C63FF"
                                            CornerRadius="0,0,0,4"
                                            Padding="6,2"
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Playlist"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Title & meta -->
                            <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                <StackPanel Visibility="{Binding IsPlaylist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SourceTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="{Binding SourceChannel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceDuration, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PlaylistTitle}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PlaylistCount, StringFormat=Playlist · {0} videos}"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Mode selector -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="Mode" Content="Video" IsChecked="{Binding IsVideoMode, Mode=TwoWay}" />
                                <RadioButton GroupName="Mode" Content="Audio" IsChecked="{Binding IsAudioMode, Mode=TwoWay}" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Options row -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="QUALITY" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <Grid>
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding VideoQualityOptions}"
                                              SelectedItem="{Binding SelectedVideoQuality, Mode=TwoWay}"
                                              Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox Width="150"
                                              ItemsSource="{Binding AudioQualityOptions}"
                                              SelectedItem="{Binding SelectedAudioQuality, Mode=TwoWay}"
                                              Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="FORMAT" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <Grid>
                                    <ComboBox Width="110"
                                              ItemsSource="{Binding ContainerOptions}"
                                              SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                              Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox Width="110"
                                              ItemsSource="{Binding AudioFormats}"
                                              SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}"
                                              Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="CONNECTIONS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <ComboBox Width="70"
                                          ItemsSource="{Binding ConnectionsOptions}"
                                          SelectedItem="{Binding Connections, Mode=TwoWay}"
                                          ToolTip="Parallel fragment connections" />
                            </StackPanel>

                            <CheckBox Grid.Column="3"
                                      Content="Subtitles"
                                      Margin="14,26,0,0"
                                      IsChecked="{Binding IncludeSubtitles, Mode=TwoWay}"
                                      Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Embed English subtitles" />

                            <StackPanel Grid.Column="4" Margin="14,0,0,0">
                                <TextBlock Text="SAVE TO" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Padding="10,5"
                                             Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseDestinationCommand}"
                                            ToolTip="Choose folder">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Margin="4,0,0,0"
                                            Command="{Binding OpenDestinationCommand}"
                                            ToolTip="Open folder">
                                        <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Playlist card -->
                <Border Margin="0,10,0,0" Padding="12"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Videos" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" FontSize="13" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TextButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                                <Button Style="{StaticResource TextButton}" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                                <TextBox Width="80"
                                         Padding="8,5"
                                         FontSize="12"
                                         Margin="8,0,0,0"
                                         Tag="1–20"
                                         Text="{Binding RangeInput, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource TextButton}" Content="Apply" Command="{Binding ApplyRangeCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Error}"
                                   Foreground="{DynamicResource Error}"
                                   FontSize="12"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />

                        <Border Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,6,0,0"
                                Padding="3"
                                MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource SlimScrollViewer}">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,6" Background="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               Margin="10,0,10,0"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DurationText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}"
                        Content="Cancel"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Padding="20,8"
                        Margin="0,0,10,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding DownloadCommand}"
                        Click="Download_Click"
                        Padding="22,8"
                        ToolTip="{Binding DestinationFolder}">
                    <StackPanel Orientation="Horizontal">
                        <Control Style="{StaticResource DownloadGlyph}"
                                 Width="15"
                                 Height="15"
                                 Margin="0,0,8,0" />
                        <TextBlock Text="{Binding DownloadLabel}" FontSize="13" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
