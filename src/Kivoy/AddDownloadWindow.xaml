<Window x:Class="Kivoy.AddDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy — New Download"
        Width="720" Height="680"
        MinWidth="640" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,6">

                <!-- URL section -->
                <Border Padding="10"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="URL:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="UrlBox"
                                 Grid.Column="1"
                                 Margin="8,0,0,0"
                                 Padding="8,5"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Command="{Binding PasteUrlCommand}"
                                ToolTip="Paste from clipboard">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77F;" FontFamily="{DynamicResource IconFont}" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="Paste" />
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="3"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                Padding="18,5"
                                Command="{Binding AnalyzeCommand}"
                                ToolTip="Analyze link (Enter)">
                            <Grid>
                                <TextBlock Text="Analyze"
                                           Visibility="{Binding IsAnalyzing, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                                    <ContentControl Style="{StaticResource Spinner}" Width="12" Height="12" />
                                    <TextBlock Text="Analyzing…" Margin="6,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <Border Padding="12"
                        Margin="0,10,0,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="176" Height="99" Background="{DynamicResource ThumbnailBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding SourceThumbnail}" Stretch="UniformToFill" />
                                    <Border Background="#CC000000"
                                            Padding="5,1"
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Visibility="{Binding IsPlaylist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding SourceDuration}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                    <Border Background="#CC000000"
                                            Padding="5,1"
                                            Margin="0,0,4,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Playlist"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <StackPanel Visibility="{Binding IsPlaylist, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding SourceTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <Run Text="{Binding SourceChannel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceDuration, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PlaylistTitle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding PlaylistCount, StringFormat=Playlist · {0} videos}"
                                               Margin="0,4,0,0"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton GroupName="Mode" Content="Video" IsChecked="{Binding IsVideoMode, Mode=TwoWay}" />
                                <RadioButton GroupName="Mode" Content="Audio" IsChecked="{Binding IsAudioMode, Mode=TwoWay}" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Quality" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <Grid>
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding VideoQualityOptions}"
                                              SelectedItem="{Binding SelectedVideoQuality, Mode=TwoWay}"
                                              Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox Width="180"
                                              ItemsSource="{Binding AudioQualityOptions}"
                                              SelectedItem="{Binding SelectedAudioQuality, Mode=TwoWay}"
                                              Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Format" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <Grid>
                                    <ComboBox Width="130"
                                              ItemsSource="{Binding ContainerOptions}"
                                              SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                              Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                    <ComboBox Width="130"
                                              ItemsSource="{Binding AudioFormats}"
                                              SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}"
                                              Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                <TextBlock Text="Connections" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox Width="80"
                                          ItemsSource="{Binding ConnectionsOptions}"
                                          SelectedItem="{Binding Connections, Mode=TwoWay}"
                                          ToolTip="Parallel fragment connections (like IDM segments)" />
                            </StackPanel>

                            <CheckBox Grid.Column="3"
                                      Content="Subtitles"
                                      Margin="14,27,0,0"
                                      IsChecked="{Binding IncludeSubtitles, Mode=TwoWay}"
                                      Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}"
                                      ToolTip="Embed English subtitles" />

                            <StackPanel Grid.Column="4" Margin="14,0,0,0">
                                <TextBlock Text="Save to" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Padding="8,5" Tag="Download folder"
                                             Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource IconButton}"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseDestinationCommand}"
                                            ToolTip="Choose folder">
                                        <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Margin="4,0,0,0"
                                            Command="{Binding OpenDestinationCommand}"
                                            ToolTip="Open folder">
                                        <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,10,0,0" Padding="12"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Videos" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TextButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                                <Button Style="{StaticResource TextButton}" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                                <TextBox Width="80" Padding="8,5" FontSize="12"
                                         Margin="8,0,0,0"
                                         Tag="1–20"
                                         Text="{Binding RangeInput, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource TextButton}" Content="Apply" Command="{Binding ApplyRangeCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding Error}"
                                   Foreground="{DynamicResource Error}"
                                   FontSize="11.5"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />

                        <Border Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                Margin="0,6,0,0"
                                Padding="2"
                                MaxHeight="240">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="Padding" Value="6,4" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource RowHover}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Resources>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               Margin="8,0,8,0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DurationText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextTertiary}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}"
                        Content="Cancel"
                        IsCancel="True"
                        Click="Cancel_Click"
                        Padding="18,6"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding DownloadCommand}"
                        Click="Download_Click"
                        Padding="22,6"
                        ToolTip="{Binding DestinationFolder}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="11" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding DownloadLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
