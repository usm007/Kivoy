<Window x:Class="Kivoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Width="1000" Height="650"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="56" />
            <!-- Notifications -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="26" Height="26"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kivoy"
                               FontSize="16.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Padding="15,0"
                            Margin="0,0,10,0"
                            Click="NewDownload_Click"
                            ToolTip="Add a new download">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       LineHeight="17"
                                       Margin="0,1,7,0" />
                            <TextBlock Text="New Download" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding PauseAllCommand}"
                            ToolTip="Pause all downloads">
                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" />
                    </Button>

                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" />
                    </Button>

                    <Button Style="{StaticResource HeaderIconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Toggle light / dark theme">
                        <TextBlock FontFamily="{StaticResource IconFont}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= Notifications ======================= -->
        <StackPanel Grid.Row="1">

            <!-- Error banner -->
            <Border Margin="16,8,16,0"
                    Background="{DynamicResource NotificationBackground}"
                    BorderBrush="{DynamicResource Error}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,7"
                    Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               Foreground="{DynamicResource Error}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Error}"
                               Foreground="{DynamicResource Error}"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="9,0,0,0" />
                </StackPanel>
            </Border>

            <!-- Engine setup banner -->
            <Border Margin="16,8,16,0"
                    Background="{DynamicResource NotificationBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Visibility="{Binding EngineBusy, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="11,0,11,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding EngineStatusText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <ProgressBar Height="4"
                                     Margin="0,6,0,0"
                                     Value="{Binding EnginePercent, Mode=OneWay}"
                                     Maximum="100" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Style="{StaticResource TextButton}"
                            Visibility="{Binding EngineFailed, Converter={StaticResource BoolToVis}}"
                            Command="{Binding RetryEngineCommand}"
                            Content="Retry" />
                </Grid>
            </Border>

        </StackPanel>

        <!-- ======================= Content ======================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SidebarBackground}">
                <DockPanel Margin="0,10,0,10">

                    <!-- Single existing action, kept quiet -->
                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource NavItemButton}"
                            Command="{Binding OpenDestinationCommand}"
                            ToolTip="Open the downloads folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Open folder" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <ListBox Style="{StaticResource Sidebar}"
                             SelectedValuePath="Tag"
                             SelectedValue="{Binding SelectedView, Mode=TwoWay}">
                        <ListBoxItem Tag="All">
                            <DockPanel>
                                <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right">
                                    <TextBlock Text="{Binding ActiveJobs.Count}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13.5"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="All Downloads" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Active">
                            <DockPanel>
                                <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right"
                                        Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ActiveCount}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Control Style="{StaticResource DownloadGlyph}"
                                             Width="13"
                                             Height="13"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Active" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Completed">
                            <DockPanel>
                                <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right"
                                        Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding HistoryCount}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="13.5"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="Completed" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============ Jobs view ============ -->
            <Grid Grid.Column="1"
                  Visibility="{Binding IsJobsView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page header -->
                <Grid Grid.Row="0" Margin="20,12,20,2">
                    <TextBlock Text="Active Downloads" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ActiveCount, StringFormat='{}{0} active'}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}" />
                    </Border>
                </Grid>

                <!-- Download cards -->
                <ListView Grid.Row="1"
                          Margin="20,8,20,12"
                          ItemsSource="{Binding ViewJobs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Single"
                          PreviewMouseDoubleClick="DownloadsList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DownloadCardItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="86">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail 16:9 -->
                                <Grid Grid.Column="0" Width="150" Height="84" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{DynamicResource ThumbnailBg}" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{DynamicResource ThumbnailBg}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Control Style="{StaticResource DownloadGlyph}"
                                                 Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource GlyphSecondary}" />
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Percent, StringFormat={}{0:0}%}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StateText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>

                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Item.Channel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Options.Mode, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Options.Quality.Label, Mode=OneWay}" />
                                    </TextBlock>

                                    <ProgressBar Height="4"
                                                 Margin="0,7,0,0"
                                                 Value="{Binding Percent}"
                                                 Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding SpeedText, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding EtaText, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding EtaText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PauseCommand}"
                                            ToolTip="Pause"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding ResumeCommand}"
                                            ToolTip="Resume"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding CancelCommand}"
                                            ToolTip="Cancel"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding RetryCommand}"
                                            ToolTip="Retry"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PlayCommand}"
                                            ToolTip="Play"
                                            Visibility="{Binding OutputExists, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Click="CardMore_Click"
                                            ToolTip="More actions">
                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state — small and quiet -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Control Style="{StaticResource DownloadGlyph}"
                             Width="28" Height="28"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource GlyphSecondary}" />
                    <TextBlock Text="No downloads yet"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Use New Download to add your first link."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- ============ Completed view ============ -->
            <Grid Grid.Column="1"
                  Visibility="{Binding IsCompletedView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page header + search -->
                <Grid Grid.Row="0" Margin="20,12,20,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Completed Downloads" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Width="230"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBox Grid.Column="1"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     Padding="7,0"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Compact completed rows -->
                <ListView Grid.Row="1"
                          Margin="20,8,20,12"
                          ItemsSource="{Binding HistoryItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Single"
                          PreviewMouseDoubleClick="HistoryList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource CompletedRowItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource AccentSubtle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Success}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1" Width="76" Height="43" CornerRadius="5"
                                        Background="{DynamicResource ThumbnailBg}"
                                        ClipToBounds="True"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PlayCommand}"
                                            ToolTip="Play"
                                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="Open file location">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Click="CardMore_Click"
                                            ToolTip="More actions">
                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty history -->
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="24"
                               Foreground="{DynamicResource GlyphSecondary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing here yet"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Completed downloads will appear here."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Border Grid.Row="3"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource ProgressTrack}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineFailed}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EngineStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
