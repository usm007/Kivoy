<Window x:Class="Kivoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy"
        Width="960" Height="720"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Menu bar ======================= -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="New Download" Click="NewDownload_Click" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="_Downloads">
                <MenuItem Header="Pause All" Command="{Binding PauseAllCommand}" />
                <MenuItem Header="Resume All" Command="{Binding ResumeAllCommand}" />
                <Separator />
                <MenuItem Header="Open Downloads Folder" Command="{Binding OpenDestinationCommand}" />
                <MenuItem Header="Clear Finished" Command="{Binding ClearFinishedCommand}" />
                <MenuItem Header="Clear History" Command="{Binding ClearHistoryCommand}" />
                <Separator />
                <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About Kivoy" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ======================= Toolbar ======================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1"
                Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarItem}" Click="NewDownload_Click" ToolTip="New download">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource Success}" HorizontalAlignment="Center" />
                        <TextBlock Text="New Task" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding PauseAllCommand}" ToolTip="Pause all">
                    <StackPanel>
                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="Pause All" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding ResumeAllCommand}" ToolTip="Resume all">
                    <StackPanel>
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="Resume All" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding ClearFinishedCommand}" ToolTip="Clear finished">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="Clear" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="34" Background="{DynamicResource CardBorder}" Margin="4,2" />
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding OpenDestinationCommand}" ToolTip="Open downloads folder">
                    <StackPanel>
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="Folder" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding OpenSettingsCommand}" ToolTip="Settings">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}" HorizontalAlignment="Center" />
                        <TextBlock Text="Settings" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarItem}" Command="{Binding ToggleThemeCommand}" ToolTip="Toggle theme">
                    <StackPanel>
                        <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource GlyphColor}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Theme" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ======================= Error line ======================= -->
        <TextBlock Grid.Row="2"
                   Margin="14,7,14,0"
                   Text="{Binding Error}"
                   Foreground="{DynamicResource Error}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />

        <!-- ======================= Engine setup bar ======================= -->
        <Border Grid.Row="3"
                Margin="12,7,12,0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                Padding="10,7"
                Visibility="{Binding EngineBusy, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineStatusText}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextPrimary}" />
                    <ProgressBar Height="4"
                                 Margin="0,5,0,0"
                                 Value="{Binding EnginePercent, Mode=OneWay}"
                                 Maximum="100" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource TextButton}"
                        Visibility="{Binding EngineFailed, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RetryEngineCommand}"
                        Content="Retry" />
            </Grid>
        </Border>

        <!-- ======================= Content ======================= -->
        <Grid Grid.Row="4" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="185" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackground}">
                <ListBox Style="{StaticResource Sidebar}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedView, Mode=TwoWay}">
                    <ListBoxItem Tag="All">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource GlyphColor}" VerticalAlignment="Center" />
                            <TextBlock Text="All downloads" Margin="8,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Active">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource Success}" VerticalAlignment="Center" />
                            <TextBlock Text="Active" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding ActiveCount}"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Completed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource IconFont}" FontSize="12" Foreground="{DynamicResource GlyphColor}" VerticalAlignment="Center" />
                            <TextBlock Text="Completed" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding HistoryCount}"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextTertiary}"
                                       Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Downloads table -->
            <Grid Grid.Column="1" Margin="10,0,0,0"
                  Visibility="{Binding IsJobsView, Converter={StaticResource BoolToVis}}">
                <ListView ItemsSource="{Binding ViewJobs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="DownloadsList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewRowItem}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Play" Command="{Binding PlayCommand}" />
                                        <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Pause" Command="{Binding PauseCommand}" />
                                        <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                                        <MenuItem Header="Cancel" Command="{Binding CancelCommand}" />
                                        <MenuItem Header="Retry" Command="{Binding RetryCommand}" />
                                        <Separator />
                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File name" Width="300">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource BlueLink}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Size" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Progress" Width="180">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Height="6"
                                                         Margin="0,0,44,0"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding Percent}"
                                                         Maximum="100"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Speed" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SpeedText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Time left" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EtaText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Saved to" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="190">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding OpenFolderCommand}"
                                                    ToolTip="Open folder">
                                                <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PlayCommand}"
                                                    ToolTip="Play"
                                                    Visibility="{Binding OutputExists, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PauseCommand}"
                                                    ToolTip="Pause"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE769;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding ResumeCommand}"
                                                    ToolTip="Resume"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RetryCommand}"
                                                    ToolTip="Retry"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding CancelCommand}"
                                                    ToolTip="Cancel"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE896;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="22"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="No active downloads"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Click New Task and paste a link to get started."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- History table -->
            <Grid Grid.Column="1" Margin="10,0,0,0"
                  Visibility="{Binding IsCompletedView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Search:"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center" />
                    <TextBox Width="220"
                             Margin="8,0,0,0"
                             Padding="8,5"
                             Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <ListView Grid.Row="1" Margin="0,8,0,0"
                          ItemsSource="{Binding HistoryItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="HistoryList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewRowItem}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Play" Command="{Binding PlayCommand}" />
                                        <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="Copy Link" Command="{Binding CopyLinkCommand}" />
                                        <Separator />
                                        <MenuItem Header="Download Again" Command="{Binding RedownloadCommand}" />
                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="File name" Width="320">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource BlueLink}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Quality" Width="110">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.QualityText}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Saved to" Width="220">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.FilePath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Completed" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.CompletedAt, StringFormat={}{0:MMM d, yyyy HH:mm}}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PlayCommand}"
                                                    ToolTip="Play"
                                                    Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding OpenFolderCommand}"
                                                    ToolTip="Open file location">
                                                <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RedownloadCommand}"
                                                    ToolTip="Download again">
                                                <TextBlock Text="&#xE896;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove from history">
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="{DynamicResource IconFont}"
                               FontSize="22"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing here yet"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="Completed downloads will show up here."
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Border Grid.Row="5"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="10,3">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding EngineStatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
