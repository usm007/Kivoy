<Window x:Class="Kivoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Width="1000" Height="650"
        MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- ======================= Main ======================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="212" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar: identity + navigation ============ -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SidebarBackground}">
                <DockPanel Margin="0,14,0,12">

                    <Button DockPanel.Dock="Bottom"
                            Style="{StaticResource NavItemButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Open settings"
                            Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel>
                        <TextBlock Text="DOWNLOADS" Style="{StaticResource SidebarSectionHeader}" />

                        <ListBox Style="{StaticResource Sidebar}"
                                 SelectedValuePath="Tag"
                                 SelectedValue="{Binding SelectedView, Mode=TwoWay}">
                            <ListBoxItem Tag="All">
                                <DockPanel>
                                    <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right">
                                        <TextBlock Text="{Binding ActiveJobs.Count}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE80F;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="All Downloads" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Active">
                                <DockPanel>
                                    <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right"
                                            Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ActiveCount}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Control Style="{StaticResource DownloadGlyph}"
                                                 Width="13"
                                                 Height="13"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="Active" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="Completed">
                                <DockPanel>
                                    <Border Style="{StaticResource CountBadge}" DockPanel.Dock="Right"
                                            Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding HistoryCount}"
                                                   FontSize="10.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="13.5"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="Completed" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ Workspace ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Add Download bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Preview / advanced options -->
                    <RowDefinition Height="Auto" />
                    <!-- Notifications -->
                    <RowDefinition Height="Auto" />
                    <!-- List -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Page title -->
                <Grid Grid.Row="0" Margin="20,14,20,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Downloads" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Width="230"
                            Height="30"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1"
                            CornerRadius="7"
                            Visibility="{Binding IsCompletedView, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextTertiary}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                            <TextBox Grid.Column="1"
                                     Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     Padding="7,0"
                                     FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== Inline Add Download bar ===== -->
                <Border Grid.Row="1"
                        Margin="20,0,20,0"
                        MinHeight="44"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        AllowDrop="True"
                        Drop="AddBar_Drop"
                        DragOver="AddBar_DragOver">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Control Style="{StaticResource DownloadGlyph}"
                                 Width="15"
                                 Height="15"
                                 Margin="13,0,0,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource GlyphSecondary}" />

                        <TextBox x:Name="AddBarBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 Padding="11,11,4,11"
                                 FontSize="12.5"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Paste a link, drag a URL here, or press Enter"
                                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />

                        <ContentControl Grid.Column="2"
                                        Style="{StaticResource Spinner}"
                                        Width="14" Height="14"
                                        Margin="0,0,11,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}" />

                        <Button Grid.Column="2"
                                x:Name="AddBarSubmit"
                                Width="28" Height="28"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                Click="AddBarSubmit_Click"
                                ToolTip="Analyze, then download">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{DynamicResource AccentSubtle}"
                                            CornerRadius="6"
                                            Width="28" Height="28">
                                        <TextBlock Text="+"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DDE3FC" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Preview strip (after analyze) ===== -->
                <StackPanel Grid.Row="2" Margin="20,8,20,0"
                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">

                    <Border Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="80" Height="45" CornerRadius="5"
                                    Background="{DynamicResource ThumbnailBg}"
                                    ClipToBounds="True"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding SourceThumbnail}" Stretch="UniformToFill" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="11,0,10,0" VerticalAlignment="Center">
                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SourceTitle, Mode=OneWay}" /><Run Text="{Binding PlaylistTitle, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding SourceChannel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceDuration, Mode=OneWay}" /><Run Text="{Binding PlaylistCount, Mode=OneWay, StringFormat='Playlist · {0} videos'}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <RadioButton GroupName="Mode" Content="Video" FontSize="12"
                                             IsChecked="{Binding IsVideoMode, Mode=TwoWay}" />
                                <RadioButton GroupName="Mode" Content="Audio" FontSize="12" Margin="9,0,0,0"
                                             IsChecked="{Binding IsAudioMode, Mode=TwoWay}" />
                                <ComboBox Width="112" Height="28" FontSize="12" Margin="11,0,0,0"
                                          ItemsSource="{Binding VideoQualityOptions}"
                                          SelectedItem="{Binding SelectedVideoQuality, Mode=TwoWay}"
                                          Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                <ComboBox Width="112" Height="28" FontSize="12" Margin="11,0,0,0"
                                          ItemsSource="{Binding AudioQualityOptions}"
                                          SelectedItem="{Binding SelectedAudioQuality, Mode=TwoWay}"
                                          Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}"
                                        Command="{Binding DismissPanelCommand}"
                                        ToolTip="Dismiss preview">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Secondary: advanced options toggle -->
                    <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                        <Button Style="{StaticResource TextButton}"
                                Click="AdvancedToggle_Click"
                                x:Name="AdvancedToggle">
                            <TextBlock Text="More options" FontSize="11.5" />
                        </Button>
                        <TextBlock Text="·  Enter to start the download"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- Advanced options panel -->
                    <Border x:Name="AdvancedPanel"
                            Background="{DynamicResource CardBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,6,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="FORMAT" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                                    <Grid>
                                        <ComboBox Width="105"
                                                  ItemsSource="{Binding ContainerOptions}"
                                                  SelectedItem="{Binding SelectedContainer, Mode=TwoWay}"
                                                  Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}" />
                                        <ComboBox Width="105"
                                                  ItemsSource="{Binding AudioFormats}"
                                                  SelectedItem="{Binding SelectedAudioFormat, Mode=TwoWay}"
                                                  Visibility="{Binding IsAudioMode, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="CONNECTIONS" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                                    <ComboBox Width="68"
                                              ItemsSource="{Binding ConnectionsOptions}"
                                              SelectedItem="{Binding Connections, Mode=TwoWay}"
                                              ToolTip="Parallel fragment connections" />
                                </StackPanel>

                                <CheckBox Grid.Column="2"
                                          Content="Subtitles"
                                          Margin="12,22,0,0"
                                          IsChecked="{Binding IncludeSubtitles, Mode=TwoWay}"
                                          Visibility="{Binding IsVideoMode, Converter={StaticResource BoolToVis}}"
                                          ToolTip="Embed English subtitles" />

                                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                    <TextBlock Text="SAVE TO" Style="{StaticResource SectionHeader}" Margin="0,0,0,5" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Padding="8,4"
                                                 FontSize="12"
                                                 Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                Margin="5,0,0,0"
                                                Command="{Binding BrowseDestinationCommand}"
                                                ToolTip="Choose folder">
                                            <TextBlock Text="&#xE8B7;" FontFamily="{DynamicResource IconFont}" FontSize="11.5" />
                                        </Button>
                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButton}"
                                                Margin="3,0,0,0"
                                                Command="{Binding OpenDestinationCommand}"
                                                ToolTip="Open folder">
                                            <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="11.5" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Playlist picker -->
                            <Border Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,10,0,0"
                                    Padding="3"
                                    MaxHeight="180"
                                    Visibility="{Binding IsPlaylist, Converter={StaticResource BoolToVis}}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5,4,5,4">
                                        <Button Style="{StaticResource TextButton}" Content="Select all" Command="{Binding SelectAllCommand}" />
                                        <Button Style="{StaticResource TextButton}" Content="None" Command="{Binding SelectNoneCommand}" Margin="4,0,0,0" />
                                        <TextBox Width="70"
                                                 Padding="6,3"
                                                 FontSize="11"
                                                 Margin="8,0,0,0"
                                                 Tag="1–20"
                                                 Text="{Binding RangeInput, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Style="{StaticResource TextButton}" Content="Apply" Command="{Binding ApplyRangeCommand}" Margin="6,0,0,0" />
                                        <TextBlock Text="{Binding Error}"
                                                   Foreground="{DynamicResource Error}"
                                                   FontSize="11"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Style="{StaticResource SlimScrollViewer}">
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="7,4" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       Margin="9,0,9,0"
                                                                       FontSize="11.5"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding DurationText}"
                                                                       FontSize="10.5"
                                                                       Foreground="{DynamicResource TextTertiary}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Notifications ===== -->
                <StackPanel Grid.Row="3" Margin="20,8,20,0">

                    <!-- Engine setup banner -->
                    <Border Margin="0,0,0,6"
                            Background="{DynamicResource NotificationBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,8"
                            Visibility="{Binding EngineBusy, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource Spinner}" Width="14" Height="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="11,0,11,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EngineStatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <ProgressBar Height="4"
                                             Margin="0,6,0,0"
                                             Value="{Binding EnginePercent, Mode=OneWay}"
                                             Maximum="100" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Style="{StaticResource TextButton}"
                                    Visibility="{Binding EngineFailed, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding RetryEngineCommand}"
                                    Content="Retry" />
                        </Grid>
                    </Border>

                    <!-- Login required -->
                    <Border Background="{DynamicResource NotificationBackground}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7"
                            Margin="0,0,0,6"
                            Visibility="{Binding LoginRequired, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="This video needs a signed-in YouTube account."
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Padding="12,4"
                                        Command="{Binding SignInYouTubeCommand}">
                                    <TextBlock Text="Sign in to YouTube" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                                <Button Style="{StaticResource IconButton}"
                                        Margin="5,0,0,0"
                                        Command="{Binding DismissLoginNoticeCommand}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Analyze error -->
                    <Border Background="{DynamicResource NotificationBackground}"
                            BorderBrush="{DynamicResource Error}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7"
                            Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Error}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error}"
                                       Foreground="{DynamicResource Error}"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="9,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Download cards ===== -->
                <ListView Grid.Row="4"
                          Margin="20,10,20,12"
                          ItemsSource="{Binding ViewJobs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Single"
                          PreviewMouseDoubleClick="DownloadsList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DownloadCardItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="86">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Width="150" Height="84" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{DynamicResource ThumbnailBg}" ClipToBounds="True">
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <Border CornerRadius="6" Background="{DynamicResource ThumbnailBg}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Control Style="{StaticResource DownloadGlyph}"
                                                 Width="22" Height="22"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource GlyphSecondary}" />
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Percent, StringFormat={}{0:0}%}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StateText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </Grid>

                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Item.Channel, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Options.Mode, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Options.Quality.Label, Mode=OneWay}" />
                                    </TextBlock>

                                    <ProgressBar Height="4"
                                                 Margin="0,7,0,0"
                                                 Value="{Binding Percent}"
                                                 Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding SpeedText, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding SpeedText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="  ·  " FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   Visibility="{Binding EtaText, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding EtaText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsProgressVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PauseCommand}"
                                            ToolTip="Pause"
                                            Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding ResumeCommand}"
                                            ToolTip="Resume"
                                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding CancelCommand}"
                                            ToolTip="Cancel"
                                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding RetryCommand}"
                                            ToolTip="Retry"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PlayCommand}"
                                            ToolTip="Play"
                                            Visibility="{Binding OutputExists, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Click="CardMore_Click"
                                            ToolTip="More actions">
                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- ===== Compact completed rows ===== -->
                <ListView Grid.Row="4"
                          Margin="20,10,20,12"
                          ItemsSource="{Binding HistoryItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          SelectionMode="Single"
                          PreviewMouseDoubleClick="HistoryList_DoubleClick"
                          Visibility="{Binding IsCompletedView, Converter={StaticResource BoolToVis}}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource CompletedRowItem}" />
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="22" Height="22" CornerRadius="11"
                                        Background="{DynamicResource AccentSubtle}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="10"
                                               Foreground="{DynamicResource Success}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <Border Grid.Column="1" Width="76" Height="43" CornerRadius="5"
                                        Background="{DynamicResource ThumbnailBg}"
                                        ClipToBounds="True"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="LowQuality" />
                                </Border>

                                <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding MetaText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding PlayCommand}"
                                            ToolTip="Play"
                                            Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Command="{Binding OpenFolderCommand}"
                                            ToolTip="Open file location">
                                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Style="{StaticResource CardActionButton}"
                                            Click="CardMore_Click"
                                            ToolTip="More actions">
                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- ===== Quiet empty state ===== -->
                <StackPanel Grid.Row="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Control Style="{StaticResource DownloadGlyph}"
                             Width="26" Height="26"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource GlyphSecondary}" />
                    <TextBlock Text="No downloads yet"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"
                               Margin="0,9,0,0" />
                    <TextBlock Text="Paste a link above to begin"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource HeaderIconButton}"
                            Width="24" Height="24"
                            Command="{Binding OpenDestinationCommand}"
                            ToolTip="Open downloads folder">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="8,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource ProgressTrack}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EngineReady}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineBusy}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding EngineFailed}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Error}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding EngineStatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiary}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
