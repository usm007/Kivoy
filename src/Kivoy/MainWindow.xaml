<Window x:Class="Kivoy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy"
        Icon="pack://application:,,,/Assets/app_icon.png"
        Width="672" Height="504"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="44" />
            <!-- Error banner -->
            <RowDefinition Height="Auto" />
            <!-- Engine setup banner -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <!-- ======================= Header ======================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo / app name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app_icon.png"
                           Width="26" Height="26"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Kivoy"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- New Download -->
                    <Button Style="{StaticResource PrimaryButton}"
                            Padding="16,7"
                            Margin="0,0,8,0"
                            Click="NewDownload_Click"
                            ToolTip="Add a new download">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       LineHeight="16"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="New Download" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" LineHeight="19" />
                        </StackPanel>
                    </Button>

                    <!-- Pause All -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding PauseAllCommand}"
                            ToolTip="Pause all">
                        <TextBlock Text="&#xE769;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                    <!-- Resume All -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding ResumeAllCommand}"
                            ToolTip="Resume all">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                    <!-- Clear Finished -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding ClearFinishedCommand}"
                            ToolTip="Clear finished">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="20" Background="{DynamicResource CardBorder}" Margin="6,0" />

                    <!-- Open Folder -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding OpenDestinationCommand}"
                            ToolTip="Open downloads folder">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                    <!-- Theme toggle -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Toggle light / dark">
                        <TextBlock FontFamily="{StaticResource IconFont}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDark}" Value="True">
                                            <Setter Property="Text" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Exit -->
                    <Button Style="{StaticResource HeaderIconButton}"
                            Margin="1,0"
                            Command="{Binding ExitCommand}"
                            ToolTip="Exit">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================= Error banner ======================= -->
        <Border Grid.Row="1"
                Margin="18,8,18,0"
                Background="{DynamicResource NotificationBackground}"
                BorderBrush="{DynamicResource Error}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,8"
                Visibility="{Binding Error, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="13"
                           Foreground="{DynamicResource Error}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Error}"
                           Foreground="{DynamicResource Error}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- ======================= Engine setup banner ======================= -->
        <Border Grid.Row="2"
                Margin="18,8,18,0"
                Background="{DynamicResource NotificationBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Visibility="{Binding EngineBusy, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl Style="{StaticResource Spinner}" Width="16" Height="16" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EngineStatusText}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <ProgressBar Height="4"
                                 Margin="0,6,0,0"
                                 Value="{Binding EnginePercent, Mode=OneWay}"
                                 Maximum="100" />
                </StackPanel>
                <Button Grid.Column="2"
                        Style="{StaticResource TextButton}"
                        Visibility="{Binding EngineFailed, Converter={StaticResource BoolToVis}}"
                        Command="{Binding RetryEngineCommand}"
                        Content="Retry" />
            </Grid>
        </Border>

        <!-- ======================= Content ======================= -->
        <Grid Grid.Row="3" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SidebarBackground}">
                <ListBox Style="{StaticResource Sidebar}"
                         SelectedValuePath="Tag"
                         SelectedValue="{Binding SelectedView, Mode=TwoWay}">
                    <ListBoxItem Tag="All">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource GlyphColor}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="All downloads"
                                       FontSize="13"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Active">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <Control Style="{StaticResource DownloadGlyph}"
                                     Foreground="{DynamicResource Success}" />
                            <TextBlock Text="Active"
                                       FontSize="13"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSubtle}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveCount}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Completed">
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{DynamicResource IconFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource GlyphColor}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Completed"
                                       FontSize="13"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSubtle}"
                                    CornerRadius="10"
                                    Padding="7,2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding HistoryCount}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <!-- Downloads table -->
            <Grid Grid.Column="1" Margin="0"
                  Visibility="{Binding IsJobsView, Converter={StaticResource BoolToVis}}">
                <ListView ItemsSource="{Binding ViewJobs}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="DownloadsList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewRowItem}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Play" Command="{Binding PlayCommand}" />
                                        <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Pause" Command="{Binding PauseCommand}" />
                                        <MenuItem Header="Resume" Command="{Binding ResumeCommand}" />
                                        <MenuItem Header="Cancel" Command="{Binding CancelCommand}" />
                                        <MenuItem Header="Retry" Command="{Binding RetryCommand}" />
                                        <Separator />
                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="FILE NAME" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SIZE" Width="60">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="PROGRESS" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Height="4"
                                                         Margin="0,0,44,0"
                                                         VerticalAlignment="Center"
                                                         Value="{Binding Percent}"
                                                         Maximum="100"
                                                         IsIndeterminate="{Binding IsIndeterminate}"
                                                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SPEED" Width="55">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SpeedText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="ETA" Width="50">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EtaText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SAVED TO" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FolderPath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding OpenFolderCommand}"
                                                    ToolTip="Open folder">
                                                <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PlayCommand}"
                                                    ToolTip="Play"
                                                    Visibility="{Binding OutputExists, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PauseCommand}"
                                                    ToolTip="Pause"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE769;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding ResumeCommand}"
                                                    ToolTip="Resume"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RetryCommand}"
                                                    ToolTip="Retry"
                                                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE72C;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding CancelCommand}"
                                                    ToolTip="Cancel"
                                                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove"
                                                    Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasActive, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource CardBackground}" HorizontalAlignment="Center">
                        <Control Style="{StaticResource DownloadGlyph}"
                                 Width="26"
                                 Height="26"
                                 Foreground="{DynamicResource TextTertiary}"
                                 Opacity="0.6" />
                    </Border>
                    <TextBlock Text="No active downloads"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock Text="Click New Download and paste a link to get started."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- History table -->
            <Grid Grid.Column="1" Margin="0"
                  Visibility="{Binding IsCompletedView, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search bar -->
                <Border Grid.Row="0"
                        Margin="18,12,18,0"
                        Background="{DynamicResource InputBackground}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="36">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                        <TextBox Grid.Column="1"
                                 Background="Transparent"
                                 BorderBrush="Transparent"
                                 BorderThickness="0"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" Margin="0,10,0,0"
                          ItemsSource="{Binding HistoryItems}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseDoubleClick="HistoryList_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource GridViewRowItem}">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Play" Command="{Binding PlayCommand}" />
                                        <MenuItem Header="Open Folder" Command="{Binding OpenFolderCommand}" />
                                        <MenuItem Header="Copy Link" Command="{Binding CopyLinkCommand}" />
                                        <Separator />
                                        <MenuItem Header="Download Again" Command="{Binding RedownloadCommand}" />
                                        <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="FILE NAME" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="QUALITY" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.QualityText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="SAVED TO" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.FilePath}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="COMPLETED" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Entry.CompletedAt, StringFormat={}{0:MMM d, yyyy HH:mm}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="75">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding PlayCommand}"
                                                    ToolTip="Play"
                                                    Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE768;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding OpenFolderCommand}"
                                                    ToolTip="Open file location">
                                                <TextBlock Text="&#xE838;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RedownloadCommand}"
                                                    ToolTip="Download again">
                                                <Control Style="{StaticResource DownloadGlyph}" Width="13" Height="13" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}"
                                                    Command="{Binding RemoveCommand}"
                                                    ToolTip="Remove from history">
                                                <TextBlock Text="&#xE74D;" FontFamily="{DynamicResource IconFont}" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- Empty state -->
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource CardBackground}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;"
                                   FontFamily="{DynamicResource IconFont}"
                                   FontSize="24"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0.6" />
                    </Border>
                    <TextBlock Text="Nothing here yet"
                               FontSize="14.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />
                    <TextBlock Text="Completed downloads will appear here."
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ======================= Status bar ======================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <TextBlock Text="{Binding StatusBarText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding EngineStatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
