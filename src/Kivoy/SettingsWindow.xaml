<Window x:Class="Kivoy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Kivoy.Converters"
        Title="Kivoy — Settings"
        Width="600" Height="680"
        MinWidth="560" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:IsNullOrEmptyToVisibilityConverter x:Key="IsNullOrEmptyToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Body -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,14,14,6">

                <!-- General -->
                <Border Margin="0,0,0,10" Padding="16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />

                        <TextBlock Text="Default download folder" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Padding="8,5" Text="{Binding OutputFolder, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"
                                    Content="Browse…" />
                        </Grid>

                        <CheckBox Content="Auto-detect YouTube links in clipboard"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding ClipboardDetect, Mode=TwoWay}" />
                        <CheckBox Content="Show notification when a download completes"
                                  Margin="0,8,0,0"
                                  IsChecked="{Binding NotifyOnComplete, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Downloads -->
                <Border Margin="0,0,0,10" Padding="16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Downloads" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Default video quality" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding VideoQualities}"
                                          SelectedItem="{Binding DefaultVideoQuality, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default audio format" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AudioFormats}"
                                          SelectedItem="{Binding DefaultAudioFormat, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Default video container" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Containers}"
                                          SelectedItem="{Binding DefaultContainer, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Max concurrent downloads" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding MaxConcurrentOptions}"
                                          SelectedItem="{Binding MaxConcurrent, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Connections per download" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ConnectionsOptions}"
                                          SelectedItem="{Binding Connections, Mode=TwoWay}"
                                          ToolTip="Download fragments in parallel, like IDM segments" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Include English subtitles by default (videos)"
                                  Margin="0,12,0,0"
                                  IsChecked="{Binding IncludeSubtitles, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- Appearance -->
                <Border Margin="0,0,0,10" Padding="16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />
                        <TextBlock Text="Theme" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                        <ComboBox Width="220" HorizontalAlignment="Left"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- YouTube -->
                <Border Margin="0,0,0,10" Padding="16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="YouTube account" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />
                        <TextBlock FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Text="Sign in with your Google account in an embedded browser. Used for private, age-restricted or bot-checked videos — no browser extensions needed." />
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Padding="16,6"
                                    Command="{Binding SignInGoogleCommand}"
                                    Content="Sign in in browser…" />
                            <Button Style="{StaticResource GhostButton}"
                                    Padding="16,6"
                                    Margin="8,0,0,0"
                                    Command="{Binding SignOutGoogleCommand}"
                                    Visibility="{Binding IsYouTubeSignedIn, Converter={StaticResource BoolToVis}}"
                                    Content="Sign out" />
                        </StackPanel>
                        <TextBlock Text="{Binding YouTubeStatus}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="11.5"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding YouTubeStatus, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Margin="0,0,0,10" Padding="16"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" Margin="0,0,0,12" />

                        <TextBlock Text="Cookies file (for private or age-restricted videos)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Padding="8,5" Tag="Optional — none used"
                                     Text="{Binding CookiesFile, UpdateSourceTrigger=LostFocus}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseCookiesCommand}"
                                    Content="Browse…" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearCookiesCommand}"
                                    Content="Clear" />
                        </Grid>

                        <TextBlock Text="Proxy (e.g. http://127.0.0.1:8080)" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                        <TextBox Padding="8,5" Tag="Optional"
                                 Text="{Binding Proxy, UpdateSourceTrigger=LostFocus}" />

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="yt-dlp: " VerticalAlignment="Center" />
                                <TextBlock Text="{Binding YtDlpVersion}"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TextButton}"
                                        Command="{Binding UpdateYtDlpCommand}"
                                        Content="Update yt-dlp">
                                    <Button.IsEnabled>
                                        <Binding Path="IsUpdating" Converter="{StaticResource InverseBoolConverter}" />
                                    </Button.IsEnabled>
                                </Button>
                                <Button Style="{StaticResource TextButton}"
                                        Margin="10,0,0,0"
                                        Command="{Binding OpenDataFolderCommand}"
                                        Content="Open data folder" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding UpdateError}"
                                   Foreground="{DynamicResource Error}"
                                   FontSize="11.5"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding UpdateError, Converter={StaticResource IsNullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" Background="{DynamicResource StatusBarBackground}" Padding="14,10">
            <Button Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    Content="Done"
                    Command="{Binding DoneCommand}"
                    Padding="28,6" />
        </Border>
    </Grid>
</Window>
