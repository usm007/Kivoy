<Window x:Class="TubeDrop.YouTubeSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TubeDrop — Sign in with YouTube"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        FontFamily="{DynamicResource AppFont}"
        UseLayoutRounding="True"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Hint -->
        <Border Grid.Row="0" Padding="14,10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Sign in with your Google account"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Margin="0,3,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Text="This window is only used once — your session is saved as a local cookies file and refreshed automatically. Private, age-restricted and bot-checked videos will work." />
            </StackPanel>
        </Border>

        <!-- Browser -->
        <Border Grid.Row="1" Margin="12,12,12,8"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1">
            <wv2:WebView2 x:Name="WebView" />
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource StatusBarBackground}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource TextButton}"
                            Content="Reload YouTube"
                            Click="Reload_Click"
                            Margin="0,0,10,0" />
                    <Button Style="{StaticResource GhostButton}"
                            Content="Cancel"
                            IsCancel="True"
                            Click="Cancel_Click"
                            Padding="18,6"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="Use this browser session"
                            Click="UseSession_Click"
                            Padding="18,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
